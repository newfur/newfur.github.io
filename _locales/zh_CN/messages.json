  "about_title": {
    "message": "关于"
  },
  "about_dialog_title": {
    "message": "关于阅读器"
  },
  "about_dialog_desc": {
    "message": "一款面向网页、浏览器及移动设备的现代化电子书阅读器。集成多格式解析、高品质 Edge 神经网络语音朗读、智能 AI 伴侣与深度阅读统计。"
  },
  "about_features_title": {
    "message": "核心特性:"
  },
  "about_feature_1": {
    "message": "支持格式：EPUB、AZW3、MOBI、TXT、MD、FB2、CBZ 等多格式本地解析"
  },
  "about_feature_2": {
    "message": "语音朗读：直连 Edge 高品质云端神经网络 TTS，双播放器无缝预加载，支持移动端后台静音保活"
  },
  "about_feature_3": {
    "message": "极致排版：滚动与翻页布局，内置思源宋体、霞鹜文楷等字体，支持多款纸张质感底纹"
  },
  "about_feature_4": {
    "message": "AI 伴侣：支持划词释义、摘要与离线翻译，适配本地 Gemini Nano 及云端/本地大语言模型"
  },
  "about_feature_5": {
    "message": "数据与多端：包含阅读时间段分布与日历热力图，支持全量备份，适配插件、PWA 及安卓原生 App"
  },
  "about_usage_title": {
    "message": "基本用法:"
  },
  "about_usage_1": {
    "message": "导入：点击书架上的“导入书籍”按钮或直接拖拽电子书文件到书架中。"
  },
  "about_usage_2": {
    "message": "阅读与朗读：点击书籍开始阅读。点击顶部喇叭图标可开启语音朗读面板，点击句子可直接从该句开始朗读。"
  },
  "about_usage_3": {
    "message": "高亮标注：在阅读时选中文本即可弹出菜单进行划线、记笔记和发起本地 AI 交互。"
  },
  "about_usage_4": {
    "message": "备份：点击“更多” -> “备份书库”可一键导出包含书籍和阅读进度的 .zip 压缩包。"
  },
  "about_tip_title": {
    "message": "重要提示"
  },
  "about_tip_content": {
    "message": "强烈推荐下载离线单文件版！本地双击打开运行离线版，可以直接免除各种跨域（CORS）与服务代理限制，完美利用微软 Edge 原生高品质在线神经网络语音朗读（Natural TTS Engine）。"
  },
